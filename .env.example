# Copier en .env puis adapter (docker compose le lit automatiquement)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3307            # port MySQL exposé sur 127.0.0.1 de l'hôte
# Clé exigée dans l'en-tête X-API-Key (générer : openssl rand -hex 32)
API_KEY=change-me-with-openssl-rand-hex-32
ENABLE_DOCS=false          # true = expose /docs (Swagger) ; garder false en production
APP_BIND=127.0.0.1         # 127.0.0.1 = accessible seulement depuis le serveur ; 0.0.0.0 = public (déconseillé sans proxy/auth)
APP_PORT=8776
SCRAPE_INTERVAL_HOURS=6
CONCURRENCY=2
DAYS_AHEAD=30
RUN_ON_STARTUP=true
AIRPORTS=BFX,BZV,COO,DLA,GOU,LBV,MVR,NGJ,NGE,PNR,NSI
